# ===========================================================================
#  《战争的雷霆》 .gitignore
#  入库原则：能由 .tex 源文件重新生成、或体积过大的东西，一律不入库。
#  注意：git 的注释只能独占一行，行尾 # 会被当成文件名的一部分。
# ===========================================================================

# ---- LaTeX 构建产物 -------------------------------------------------------
# main.pdf 是工作副本；入库的是下面那个中文名的分发副本（由 build.sh 生成）
main.pdf
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.idx
*.ind
*.ilg
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.nav
*.snm
*.vrb
build.log

# ---- 本地 TeX 依赖（约 90 MB，由 scripts/setup-tex.sh 复现）---------------
/texmf/
/tlpkg/
texmf-var/
texmf-config/

# ---- 临时与生成物 ---------------------------------------------------------
/tmp/
/previews/
*.bak
*.orig
*~

# ---- 编辑器 / 操作系统 ----------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 语言运行时 -----------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
node_modules/

# ---- 其它 -----------------------------------------------------------------
ignores/

# ===========================================================================
#  例外
# ===========================================================================
!docs/preview/*.png
